# Opcional: para usar outro projeto Supabase, copie para .env.local e troque os valores.
# (O projeto padrão já vem em .env.development e .env.production.)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: para onde o botão "Falar com vendas" da página de planos aponta
VITE_CONTATO_VENDAS=https://wa.me/5500000000000
